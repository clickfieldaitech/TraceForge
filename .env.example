# ── Supabase (required) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── App (required) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://valvetrack.yourdomain.com

# ── Email — Resend (optional but recommended) ──────────────────────────────────
# Sign up at https://resend.com — free tier: 3 000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=ValveTrack <noreply@yourdomain.com>

# ── Error monitoring — Sentry (optional but recommended) ───────────────────────
# Sign up at https://sentry.io — free tier available
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=valvetrack

# ── WhatsApp alerts — Twilio (optional) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# ── Cron authentication (optional) ────────────────────────────────────────────
# Random secret used to authenticate cron job requests
CRON_SECRET=<random-secret-string>

# ── MCP server — Claude-as-PA (optional) ──────────────────────────────────────
# Lets Claude Desktop / claude.ai answer business questions ("kg of X material
# sold in the last 3 months") against the live database. Read-only end to end:
# mcp_reader is a dedicated Postgres role with SELECT-only grants (see
# supabase/migrations/0062_mcp_readonly_role.sql) — it cannot write no matter
# what the server code does. Generate both values yourself; never reuse
# examples. See src/app/api/mcp/route.ts for setup instructions.
# No ?sslmode= query param — TLS is configured explicitly in code
# (src/lib/mcp/db.ts) via the `ssl` Pool option; a sslmode query param on
# the URL fights with that (pg gives the query param precedence over the
# explicit ssl option, which broke the connection during setup).
MCP_READER_DATABASE_URL=postgresql://mcp_reader:<password>@db.<project-ref>.supabase.co:5432/postgres
MCP_ACCESS_TOKEN=<random-secret-string>  # e.g. openssl rand -base64 32 | tr -d '=+/'
